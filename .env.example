# Purrenade frontend — local environment template.
#
# Copy to .env and fill in machine-specific values. .env is git-ignored;
# this file is tracked and must never contain a real path or secret.

# --- Development stack launcher ----------------------------------------------
# Absolute path to the purrenade-api repository on THIS machine.
#
# The API is a separate, independent repository, so `npm run dev:stack` has to be
# told where it lives. It is deliberately not hardcoded anywhere tracked: no file
# in this repository names a path inside the other one (ADR-0001).
PURRENADE_API_DIR=

# --- Optional overrides -------------------------------------------------------
# Defaults are in nuxt.config.ts; set these only to deviate from them.
#
# Dev server bind (default 127.0.0.1:4310 — loopback only, never 0.0.0.0):
# NUXT_DEV_HOST=127.0.0.1
# NUXT_DEV_PORT=4310
#
# HMR travels through the Nginx TLS proxy, so the client dials wss on 443.
# To browse the internal port directly instead, set all three:
# NUXT_HMR_PROTOCOL=ws
# NUXT_HMR_HOST=127.0.0.1
# NUXT_HMR_PORT=4310
#
# Hosts Vite will accept (DNS-rebinding protection):
# NUXT_ALLOWED_HOSTS=purrenade.test
#
# Backend origin for SERVER-SIDE use only. This populates private runtime config
# that Nitro reads; the browser never sees it. See ADR-0005.
# NUXT_API_BASE=https://api.purrenade.test

# --- BFF (ADR-0005) -----------------------------------------------------------
# Nitro is the BFF: it holds the server-side session and the upstream API token,
# and the browser only ever gets an opaque HttpOnly cookie. None of these values
# reaches the browser — they are private runtime config.

# Upstream API origin. Private: moving it to runtimeConfig.public would expose
# the API to the browser and invert ADR-0005.
NUXT_API_BASE=https://api.purrenade.test

# Every upstream call is bounded. Without a timeout, an API that accepts
# connections and never answers exhausts this process's sockets.
NUXT_API_TIMEOUT_MS=10000

# Origins whose state-changing requests the BFF will consider. Comma-separated.
# Defence in depth behind the CSRF token, not a substitute for it.
NUXT_TRUSTED_ORIGINS=https://purrenade.test

# Session cookies. The __Host- prefix is enforced by browsers: it requires
# Secure, requires Path=/, and forbids Domain, so no subdomain can overwrite
# them. It also means they are not set over plain HTTP — use the .test hostname.
NUXT_SESSION_COOKIE=__Host-purrenade_session
NUXT_CSRF_COOKIE=__Host-purrenade_csrf

# Idle and absolute session timeouts, in minutes. Idle expires a session nobody
# is using; absolute bounds one however active. Sanctum mirrors the absolute one.
NUXT_SESSION_IDLE_MINUTES=10080
NUXT_SESSION_ABSOLUTE_MINUTES=43200

# Session store. The filesystem locally; a shared store in production, which is
# an OPS-1 decision. The path holds live credentials and is git-ignored.
#
# READ AT BUILD TIME, NOT AT RUNTIME. `nitro.storage` is not part of
# runtimeConfig, so these two are compiled into the server bundle — setting them
# in a production environment has no effect whatsoever, and the process keeps
# writing plaintext bearer tokens to the local disk. Changing the store requires
# a REBUILD with the variable set, plus the driver's own package.
#
# server/plugins/session-store-guard.ts refuses to start a production process
# whose resolved store is filesystem-backed, so this cannot fail quietly.
NUXT_SESSION_DRIVER=fs
NUXT_SESSION_FS_BASE=.data/sessions

# Acknowledge a filesystem session store in production. Only for a
# single-instance deployment whose operator has confirmed the directory is
# owner-only — the guard creates it 0700 and writes records 0600, but a store
# that cannot be shared between instances is still an availability decision.
# Leave unset everywhere else.
# PURRENADE_ALLOW_FS_SESSIONS=1
