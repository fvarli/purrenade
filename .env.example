# Purrenade frontend — local environment template.
#
# Copy to .env and fill in machine-specific values. .env is git-ignored;
# this file is tracked and must never contain a real path or secret.

# --- Development stack launcher ----------------------------------------------
# Absolute path to the purrenade-api repository on THIS machine.
#
# The API is a separate, independent repository, so `npm run dev:stack` has to be
# told where it lives. It is deliberately not hardcoded anywhere tracked: no file
# in this repository names a path inside the other one (ADR-0001).
PURRENADE_API_DIR=

# --- Optional overrides -------------------------------------------------------
# Defaults are in nuxt.config.ts; set these only to deviate from them.
#
# Dev server bind (default 127.0.0.1:4310 — loopback only, never 0.0.0.0):
# NUXT_DEV_HOST=127.0.0.1
# NUXT_DEV_PORT=4310
#
# HMR travels through the Nginx TLS proxy, so the client dials wss on 443.
# To browse the internal port directly instead, set all three:
# NUXT_HMR_PROTOCOL=ws
# NUXT_HMR_HOST=127.0.0.1
# NUXT_HMR_PORT=4310
#
# Hosts Vite will accept (DNS-rebinding protection):
# NUXT_ALLOWED_HOSTS=purrenade.test
#
# Backend origin for SERVER-SIDE use only. This populates private runtime config
# that Nitro reads; the browser never sees it. See ADR-0005.
# NUXT_API_BASE=https://api.purrenade.test
