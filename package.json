{
  "name": "purrenade",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Purrenade — browser-first, mobile-first casual endless score-attack runner.",
  "license": "UNLICENSED",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca nuxt dev",
    "dev:stack": "bin/dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contract:sync": "node scripts/contract-sync.mjs",
    "contract:generate": "openapi-typescript contracts/openapi/purrenade-api.openapi.yaml -o shared/contracts/api.generated.ts",
    "contract:check": "node scripts/contract-check.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.2",
    "nuxt": "4.5.2",
    "phaser": "4.2.1",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.2",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "happy-dom": "20.14.5",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
